# Copie para .env. A API não sobe sem as duas primeiras variáveis.
# Rode supabase/schema.sql no SQL Editor do projeto antes do primeiro boot.

SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Settings > API > service_role — só no servidor, nunca no frontend
SUPABASE_SERVICE_ROLE_KEY=
# Settings > API > anon public — esta vai pro browser (via GET /public/config),
# é pública por design e é o que permite o admin fazer login no Supabase Auth
SUPABASE_ANON_KEY=
SUPABASE_BUCKET=menu-items

# Slug do cardápio que abre em "/" e no antigo "/cardapio" — é o link que já
# está impresso na mesa do primeiro cliente. Vazio: "/" pede o slug.
TENANT_PADRAO=cafe-da-esquina

# Gratuito em https://aistudio.google.com/apikey — habilita "melhorar foto" e
# "gerar descrição" (Gemini) no admin. Sem isso os endpoints /ai/* respondem
# 503, o resto da API funciona normal.
GEMINI_API_KEY=

PORT=3000
