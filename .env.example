# Copie para .env e preencha para usar o Supabase.
# Sem essas variáveis a API sobe em modo local (.data/items.json + uploads/).

SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Settings > API > service_role (nunca exponha no frontend)
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=menu-items

PORT=3000
